---
// Two-step quote form. Owner-specified order (2026-08-01):
//   Step 1: contact details, all required. Captures the lead first.
//   Step 2: project questions + consent, then submit.
// Anti-spam: honeypot + time-to-complete stamp (Addendum A3, no OTP).
// No pricing anywhere in this component: price is the specialist's to quote.

interface Props {
  niche: any;
  city: any;
}

const { niche, city } = Astro.props;
const CONSENT_VERSION = 'consent-v0-draft';
const FORM_VERSION = 'p1-preview';
---

<div class="quote-card">
  <p class="eyebrow accent">Get a quote</p>
  <h2>Tell us about the project.</h2>
  <p class="quote-sub">Free, and no obligation.</p>

  <form
    id="quote-form"
    data-niche={niche.id}
    data-city={city.slug}
    data-form-version={FORM_VERSION}
    data-consent-version={CONSENT_VERSION}
    novalidate
  >
    <div class="step" data-step="1">
      <label class="field">
        <span>Full name</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>Phone</span>
        <input type="tel" name="phone" autocomplete="tel" required />
      </label>
      <label class="field">
        <span>Property address</span>
        <input type="text" name="address" autocomplete="street-address" required />
      </label>
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <button type="button" class="btn btn-primary btn-block" data-next>Continue</button>
    </div>

    <div class="step" data-step="2" hidden>
      {niche.form_questions.map((q) => (
        <fieldset>
          <legend>{q.label}</legend>
          {q.options.map((opt) => (
            <label class="opt">
              <input type="radio" name={q.key} value={opt} required />
              <span>{opt}</span>
            </label>
          ))}
        </fieldset>
      ))}
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          I agree that Quotd and the specialists matched to this request may
          contact me by phone, email or text. Consent is not a condition of
          purchase. <em>(Draft wording, pending legal review.)</em>
        </span>
      </label>
      <button type="submit" class="btn btn-primary btn-block">Get quoted</button>
      <button type="button" class="back" data-back>Back</button>
      <p class="quote-note" data-status role="status"></p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('quote-form');
  if (form instanceof HTMLFormElement) {
    const startedAt = Date.now();
    const step1 = form.querySelector('[data-step="1"]');
    const step2 = form.querySelector('[data-step="2"]');

    const show = (n) => {
      step1?.toggleAttribute('hidden', n !== 1);
      step2?.toggleAttribute('hidden', n !== 2);
    };

    form.querySelector('[data-next]')?.addEventListener('click', () => {
      // Validate only step 1's fields before advancing.
      const fields = step1?.querySelectorAll('input[required]') ?? [];
      for (const f of fields) {
        if (!(f instanceof HTMLInputElement)) continue;
        if (!f.checkValidity()) {
          f.reportValidity();
          return;
        }
      }
      show(2);
      step2?.querySelector('input')?.focus();
    });

    form.querySelector('[data-back]')?.addEventListener('click', () => show(1));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector('[data-status]');
      if (!form.reportValidity()) return;
      // P1 preview: intake endpoint ships in P2. Payload shape is final.
      const payload = {
        niche: form.dataset.niche,
        city: form.dataset.city,
        form_version: form.dataset.formVersion,
        consent_text_version: form.dataset.consentVersion,
        time_to_complete_ms: Date.now() - startedAt,
        fields: Object.fromEntries(new FormData(form).entries()),
      };
      console.debug('quote payload (preview)', payload);
      if (status) status.textContent = 'Preview build. The form goes live at launch.';
    });
  }
</script>

<style>
  .quote-card {
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg);
    box-shadow: var(--shadow-md);
    padding: var(--s6);
  }

  .accent {
    color: var(--accent);
  }

  .quote-card h2 {
    font-size: var(--text-xl);
    margin-block: var(--s3) var(--s2);
  }

  .quote-sub {
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding-bottom: var(--s5);
    margin-bottom: var(--s5);
    border-bottom: 1px solid var(--border);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--s5);
  }

  legend {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--s3);
    padding: 0;
  }

  .opt {
    display: flex;
    gap: var(--s3);
    align-items: center;
    padding: 0.4rem 0;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .opt input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .field {
    display: block;
    margin-bottom: var(--s4);
  }

  .field span {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--s2);
  }

  .field input {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }

  .field input::placeholder {
    color: var(--text-subtle);
  }

  .field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-tint);
  }

  .consent {
    display: flex;
    gap: var(--s3);
    align-items: flex-start;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: var(--s5);
    cursor: pointer;
  }

  .consent input {
    accent-color: var(--accent);
    margin-top: 0.15rem;
    flex: none;
  }

  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    width: 0;
    opacity: 0;
  }

  .back {
    display: block;
    margin: var(--s3) auto 0;
    background: none;
    border: 0;
    font-family: var(--sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    cursor: pointer;
  }

  .back:hover {
    color: var(--accent);
  }

  .quote-note {
    margin-top: var(--s3);
    font-size: var(--text-sm);
    color: var(--accent);
  }
</style>

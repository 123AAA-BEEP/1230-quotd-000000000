---
// Two-step quote form. Owner-specified order (2026-08-01):
//   Step 1: contact details, all required. Captures the lead first.
//   Step 2: project questions + consent, then submit.
// Anti-spam: honeypot + time-to-complete stamp (Addendum A3, no OTP).
// No pricing anywhere in this component: price is the specialist's to quote.

interface Props {
  niche: any;
  city: any;
}

const { niche, city } = Astro.props;
const CONSENT_VERSION = 'consent-v0-draft';
const FORM_VERSION = 'p1-preview';
---

<div class="quote-card">
  <p class="label">Get a quote</p>
  <h2>Tell us about the project.</h2>
  <p class="quote-sub">Free, and no obligation.</p>

  <form
    id="quote-form"
    data-niche={niche.id}
    data-city={city.slug}
    data-form-version={FORM_VERSION}
    data-consent-version={CONSENT_VERSION}
    novalidate
  >
    <p class="steps label"><span data-stepnum>Step 1 of 2</span></p>

    <div class="step" data-step="1">
      <label class="field">
        <span>Full name</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>Phone</span>
        <input type="tel" name="phone" autocomplete="tel" required />
      </label>
      <label class="field">
        <span>Property address</span>
        <input type="text" name="address" autocomplete="street-address" required />
      </label>
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <button type="button" class="btn" data-next>Continue</button>
    </div>

    <div class="step" data-step="2" hidden>
      {niche.form_questions.map((q) => (
        <fieldset>
          <legend>{q.label}</legend>
          {q.options.map((opt) => (
            <label class="opt">
              <input type="radio" name={q.key} value={opt} required />
              <span>{opt}</span>
            </label>
          ))}
        </fieldset>
      ))}
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          I agree that Quotd and the specialists matched to this request may
          contact me by phone, email or text. Consent is not a condition of
          purchase. <em>(Draft wording, pending legal review.)</em>
        </span>
      </label>
      <button type="submit" class="btn">Get quoted</button>
      <button type="button" class="back" data-back>Back</button>
      <p class="quote-note" data-status role="status"></p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('quote-form');
  if (form instanceof HTMLFormElement) {
    const startedAt = Date.now();
    const step1 = form.querySelector('[data-step="1"]');
    const step2 = form.querySelector('[data-step="2"]');
    const stepnum = form.querySelector('[data-stepnum]');

    const show = (n) => {
      step1?.toggleAttribute('hidden', n !== 1);
      step2?.toggleAttribute('hidden', n !== 2);
      if (stepnum) stepnum.textContent = `Step ${n} of 2`;
    };

    form.querySelector('[data-next]')?.addEventListener('click', () => {
      // Validate only step 1's fields before advancing.
      const fields = step1?.querySelectorAll('input[required]') ?? [];
      for (const f of fields) {
        if (!(f instanceof HTMLInputElement)) continue;
        if (!f.checkValidity()) {
          f.reportValidity();
          return;
        }
      }
      show(2);
      step2?.querySelector('input')?.focus();
    });

    form.querySelector('[data-back]')?.addEventListener('click', () => show(1));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector('[data-status]');
      if (!form.reportValidity()) return;
      // P1 preview: intake endpoint ships in P2. Payload shape is final.
      const payload = {
        niche: form.dataset.niche,
        city: form.dataset.city,
        form_version: form.dataset.formVersion,
        consent_text_version: form.dataset.consentVersion,
        time_to_complete_ms: Date.now() - startedAt,
        fields: Object.fromEntries(new FormData(form).entries()),
      };
      console.debug('quote payload (preview)', payload);
      if (status) status.textContent = 'Preview build. The form goes live at launch.';
    });
  }
</script>

<style>
  .quote-card {
    border: 1px solid var(--ink);
    border-top: 4px solid var(--accent);
    background: var(--paper);
    box-shadow: 0 1px 3px rgba(28, 25, 23, 0.06);
    padding: var(--space-3);
  }

  .quote-card .label {
    color: var(--accent);
  }

  .quote-card h2 {
    font-size: var(--step-1);
    margin-block: var(--space-1) 0.25rem;
  }

  .quote-sub {
    color: var(--ink-soft);
    font-size: var(--step--1);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .steps {
    color: var(--ink-faint);
    margin-bottom: var(--space-2);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-2);
  }

  legend {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    margin-bottom: var(--space-1);
    padding: 0;
  }

  .opt {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.2rem 0;
    font-size: var(--step--1);
  }

  .field {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--sans);
    font-size: var(--step--1);
  }

  .field span {
    display: block;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .field input {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  .field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }

  .consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    width: 0;
    opacity: 0;
  }

  .btn {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--step-0);
    background: var(--accent);
    color: #fff;
    border: 0;
    width: 100%;
    padding: 0.85rem 1.2rem;
    cursor: pointer;
  }

  .btn:hover {
    background: var(--ink);
  }

  .back {
    display: block;
    margin: 0.6rem auto 0;
    background: none;
    border: 0;
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: underline;
    cursor: pointer;
  }

  .quote-note {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--accent);
  }
</style>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  noindex?: boolean;
}

const { title, description, wide = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class:list={['wrap', 'site-header', { wide }]}>
      <a href="/" class="wordmark">Quotd</a>
      <span class="label">Toronto first · Autumn 2026</span>
    </header>

    <main class:list={['wrap', 'site-main', { wide }]}>
      <slot />
    </main>

    <footer class:list={['wrap', 'site-footer', { wide }]}>
      <hr class="rule" />
      <p>© 2026 Quotd · getquotd.com</p>
    </footer>
  </body>
</html>

<style>
  .wide {
    width: min(100% - 2.5rem, 72rem);
  }

  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3) var(--space-4);
  }

  .wordmark {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    padding-block: var(--space-4) var(--space-3);
  }

  .site-footer p {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>

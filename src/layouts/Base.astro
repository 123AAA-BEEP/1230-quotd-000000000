---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  cta?: boolean;
}

const { title, description, noindex = false, cta = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="page header-inner">
        <a href="/" class="wordmark">Quotd</a>
        <div class="header-right">
          <span class="eyebrow header-note">Toronto first</span>
          {cta && <a href="#quote" class="btn btn-primary header-cta">Get a quote</a>}
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="page footer-inner">
        <div>
          <p class="wordmark footer-mark">Quotd</p>
          <p class="footer-line muted">
            Quotes from specialists in rare, high-skill home services.
          </p>
        </div>
        <p class="footer-legal muted">© 2026 Quotd</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    height: 60px;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .wordmark:hover {
    color: var(--text);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--s5);
  }

  .header-note {
    display: none;
  }

  @media (min-width: 40rem) {
    .header-note {
      display: inline;
    }
  }

  .header-cta {
    padding-block: 0.55rem;
  }

  .site-main {
    flex: 1;
    padding-block: var(--s8) var(--s12);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--s8);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    align-items: flex-end;
    justify-content: space-between;
  }

  .footer-mark {
    font-size: var(--text-lg);
    margin-bottom: var(--s1);
  }

  .footer-line,
  .footer-legal {
    font-size: var(--text-sm);
  }
</style>

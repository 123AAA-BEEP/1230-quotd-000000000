---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { getNiche, getCity, getPages, getModules, collectSources } from '../../lib/data.js';

export function getStaticPaths() {
  return getPages().map((p) => ({ params: { niche: p.niche, city: p.city }, props: { status: p.status } }));
}

const { niche: nicheId, city: citySlug } = Astro.params;
const { status } = Astro.props;

const niche = getNiche(nicheId);
const city = getCity(citySlug);
const modules = getModules(citySlug, nicheId);
const sources = collectSources(modules);

const contentFiles = import.meta.glob('../../../data/content/*.json', { eager: true });
const content = Object.values(contentFiles)
  .map((m) => m.default ?? m)
  .find((c) => c.niche === nicheId && c.city === citySlug);

const housing = modules.housing_age;
const cost = modules.cost;
const climate = modules.climate_curing;

const MONTH_FULL = { jan: 'January', feb: 'February', mar: 'March', apr: 'April', may: 'May', jun: 'June', jul: 'July', aug: 'August', sep: 'September', oct: 'October', nov: 'November', dec: 'December' };
const monthFull = (m) => MONTH_FULL[m] ?? m;
const monthShort = (m) => monthFull(m).slice(0, 3);
const window_ = climate?.derived?.limewash_exterior_window;

const consumerTerm = niche.consumer_terms[1] ?? niche.consumer_terms[0]; // plural person-form
const h1 = `${consumerTerm.charAt(0).toUpperCase()}${consumerTerm.slice(1)} in ${city.name}`;
const year = 2026;
const title = `${h1}: Cost, Season & Who Does It (${year})`;
const description = content.answer.join(' ').slice(0, 155);

// Stat tiles render only from present, non-null module data — never defaults.
const tiles = [];
if (housing?.period_of_construction?.pre_1961_pct != null) {
  tiles.push({
    stat: `${housing.period_of_construction.pre_1961_pct}%`,
    caption: `of ${city.name} homes built before 1961, the masonry this finish suits`,
  });
}
if (housing?.heritage?.hcd_count != null) {
  tiles.push({
    stat: String(housing.heritage.hcd_count),
    caption: 'Heritage Conservation Districts, where exterior changes can need a permit',
  });
}
if (cost?.job_cost_anchors?.length) {
  tiles.push({
    stat: 'CAD $4–8',
    caption: 'per sq ft, typical exterior limewash on brick',
  });
}
if (window_?.full_months?.length) {
  const w = window_.full_months;
  tiles.push({
    stat: `${monthShort(w[0])}–${monthShort(w[w.length - 1])}`,
    caption: 'when exterior work can actually be done here',
  });
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Quotd', item: 'https://getquotd.com/' },
    { '@type': 'ListItem', position: 2, name: niche.name, item: `https://getquotd.com/${niche.id}` },
    { '@type': 'ListItem', position: 3, name: city.name, item: `https://getquotd.com/${niche.id}/${city.slug}` },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: niche.name,
  areaServed: { '@type': 'City', name: city.name },
  provider: { '@type': 'Organization', name: 'Quotd', url: 'https://getquotd.com' },
};
---

<Base title={title} description={description} wide noindex={status !== 'published'}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <div class="money">
    <article class="guide">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Quotd</a> · <span>{niche.name}</span> · <span>{city.name}</span>
      </nav>

      <h1>{h1}</h1>

      <div class="answer">
        {content.answer.map((p) => <p>{p}</p>)}
      </div>

      {tiles.length > 0 && (
        <section class="databand" aria-label="Local data">
          {tiles.map((t) => (
            <div class="tile">
              <span class="stat num">{t.stat}</span>
              <span class="cap">{t.caption}</span>
            </div>
          ))}
        </section>
      )}

      <section>
        <h2>{content.verdict.heading}</h2>
        {content.verdict.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      {window_ && (
        <section>
          <h2>When to book it</h2>
          <p>
            Limewash needs mild temperatures and a couple of dry days to cure,
            so the season here is finite.
            {' '}<strong>{monthFull(window_.full_months[0])} through {monthFull(window_.full_months.at(-1))}</strong>
            {' '}is the dependable stretch. April works late in the month once
            frost risk fades, and October only early, before the first frost
            returns around the start of November.
          </p>
          <p>
            Rain falls on about a quarter of days across that season, so the
            real cure window is always a forecast call. Late summer gives the
            best odds of a dry run. Good crews book out ahead of the season, so
            spring is when to line the work up.
          </p>
        </section>
      )}

      {cost && (
        <section>
          <h2>What limewash costs in {city.name}</h2>
          <table class="costs num">
            <thead>
              <tr><th>Project</th><th>Typical range</th></tr>
            </thead>
            <tbody>
              <tr><td>Exterior limewash on brick</td><td>$4 to $8 / sq ft</td></tr>
              <tr><td>Exterior, full house</td><td>$6 to $12 / sq ft</td></tr>
              <tr><td>Interior decorative work</td><td>from $12 / sq ft</td></tr>
            </tbody>
          </table>
          <p class="fine">
            These are published ranges, not quotes. Surface condition, access
            and prep drive the spread, and HST applies on top.
          </p>
        </section>
      )}

      {housing?.heritage && (
        <section>
          <h2>Check whether you're in a heritage district</h2>
          <p>
            {city.name} has {housing.heritage.hcd_count} Heritage Conservation
            Districts, {housing.heritage.examples.slice(0, 4).join(', ')} and
            Kensington Market among them. Inside one, changing an exterior
            finish can require a heritage permit. The century brick that makes
            these neighbourhoods good limewash territory is the same brick the
            rules exist to protect, so look up your address on the city's
            heritage map before you book anything.
          </p>
        </section>
      )}

      <section>
        <h2>{content.process.heading}</h2>
        <ol class="process">
          {content.process.steps.map((s) => <li>{s}</li>)}
        </ol>
      </section>

      <section>
        <h2>Questions {city.name} homeowners actually ask</h2>
        {content.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <p class="provenance fine">
        Local figures on this page come from Statistics Canada, Environment and
        Climate Change Canada and the City of Toronto. Last checked 1 August 2026.
      </p>
    </article>

    <div class="rail" id="quote">
      <QuoteForm niche={niche} city={city} />
    </div>
  </div>

  <a class="cta-bar" href="#quote">Get a quote</a>
</Base>

<style>
  .money {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 62rem) {
    .money {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }

    .rail {
      position: sticky;
      top: var(--space-2);
    }

    .cta-bar {
      display: none;
    }
  }

  .crumbs {
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  h1 {
    font-size: clamp(var(--step-3), 5vw, var(--step-4));
    margin-bottom: var(--space-2);
  }

  .answer {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 42rem;
  }

  .answer p {
    margin-bottom: var(--space-2);
  }

  .databand {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
    margin-block: var(--space-3) var(--space-4);
  }

  .tile {
    background: var(--paper);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .cap {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  section {
    margin-bottom: var(--space-4);
    max-width: 42rem;
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-2);
  }

  section p {
    margin-bottom: var(--space-2);
  }

  .costs {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-bottom: var(--space-2);
  }

  .costs th {
    font-family: var(--sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: left;
    color: var(--ink-soft);
  }

  .costs th,
  .costs td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .fine {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .process {
    padding-left: 1.2rem;
  }

  .process li {
    margin-bottom: var(--space-1);
  }

  .faq {
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-1);
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq p {
    margin-block: var(--space-1);
    color: var(--ink-soft);
  }

  .provenance {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2);
    max-width: 42rem;
  }

  .cta-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    padding: 0.9rem;
  }
</style>

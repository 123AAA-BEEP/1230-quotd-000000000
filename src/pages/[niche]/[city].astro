---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { getNiche, getCity, getPages, getModules } from '../../lib/data.js';

export function getStaticPaths() {
  return getPages().map((p) => ({ params: { niche: p.niche, city: p.city }, props: { status: p.status } }));
}

const { niche: nicheId, city: citySlug } = Astro.params;
const { status } = Astro.props;

const niche = getNiche(nicheId);
const city = getCity(citySlug);
const modules = getModules(citySlug, nicheId);

const contentFiles = import.meta.glob('../../../data/content/*.json', { eager: true });
const content = Object.values(contentFiles)
  .map((m) => m.default ?? m)
  .find((c) => c.niche === nicheId && c.city === citySlug);

const housing = modules.housing_age;
const cost = modules.cost;
const climate = modules.climate_curing;

const MONTH_FULL = { jan: 'January', feb: 'February', mar: 'March', apr: 'April', may: 'May', jun: 'June', jul: 'July', aug: 'August', sep: 'September', oct: 'October', nov: 'November', dec: 'December' };
const monthFull = (m) => MONTH_FULL[m] ?? m;
const window_ = climate?.derived?.limewash_exterior_window;

const consumerTerm = niche.consumer_terms[1] ?? niche.consumer_terms[0];
const h1 = `${consumerTerm.charAt(0).toUpperCase()}${consumerTerm.slice(1)} in ${city.name}`;
const title = `${h1}: Season, Heritage Rules & Getting a Quote`;
const description = content.answer.join(' ').slice(0, 155);
const hero = content.hero ?? {};
const CLUSTERS = { 'specialty-finishes': 'Specialty finishes', drainage: 'Drainage', roofing: 'Roofing' };
const kicker = CLUSTERS[niche.cluster] ?? niche.name;

// Label/value pairs. A tile renders only from real module data, never a default.
const tiles = [];
if (window_?.full_months?.length) {
  tiles.push({
    label: 'Season',
    value: `${monthFull(window_.full_months[0])} to ${monthFull(window_.full_months.at(-1))}`,
  });
}
if (housing?.heritage?.hcd_count != null) {
  tiles.push({ label: 'Heritage districts', value: `${housing.heritage.hcd_count} in ${city.name}` });
}
if (housing?.period_of_construction?.pre_1961_pct != null) {
  tiles.push({ label: 'Pre-1961 homes', value: `${housing.period_of_construction.pre_1961_pct}%` });
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Quotd', item: 'https://getquotd.com/' },
    { '@type': 'ListItem', position: 2, name: niche.name, item: `https://getquotd.com/${niche.id}` },
    { '@type': 'ListItem', position: 3, name: city.name, item: `https://getquotd.com/${niche.id}/${city.slug}` },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: niche.name,
  areaServed: { '@type': 'City', name: city.name },
  provider: { '@type': 'Organization', name: 'Quotd', url: 'https://getquotd.com' },
};
---

<Base title={title} description={description} wide noindex={status !== 'published'}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Quotd</a> <span aria-hidden="true">/</span> <span>{niche.name}</span>
    <span aria-hidden="true">/</span> <span>{city.name}</span>
  </nav>

  <div class="money">
    <div class="main">
      {hero.image ? (
        <figure class="hero">
          <img src={hero.image} alt={hero.alt} width="1200" height="750" fetchpriority="high" />
          {hero.badges?.length > 0 && (
            <div class="badges">{hero.badges.map((b) => <span class="badge">{b}</span>)}</div>
          )}
          {hero.chip && <span class="chip">{hero.chip}</span>}
          {hero.caption && <figcaption>{hero.caption}</figcaption>}
        </figure>
      ) : (
        <div class="hero hero-empty">
          <span class="label">{niche.name}</span>
          <span class="hero-empty-note">{hero.pending ?? 'Real limewashed brick, Toronto project. Awaiting owner photography.'}</span>
        </div>
      )}

      <p class="kicker label">{kicker}</p>
      <h1>{h1}</h1>
      <p class="dateline">{city.name}, {city.admin}</p>

      <div class="answer">
        {content.answer.map((p) => <p>{p}</p>)}
      </div>

      {tiles.length > 0 && (
        <div class="databand" aria-label="Local facts">
          {tiles.map((t) => (
            <div class="tile">
              <span class="label">{t.label}</span>
              <span class="tile-value num">{t.value}</span>
            </div>
          ))}
        </div>
      )}

      <section>
        <h2>{content.verdict.heading}</h2>
        {content.verdict.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      {window_ && (
        <section>
          <h2>When to book it</h2>
          <p>
            Limewash needs mild temperatures and a couple of dry days to cure,
            so the season here is finite.
            {' '}<strong>{monthFull(window_.full_months[0])} through {monthFull(window_.full_months.at(-1))}</strong>
            {' '}is the dependable stretch. April works late in the month once
            frost risk fades, and October only early, before the first frost
            returns around the start of November.
          </p>
          <p>
            Rain falls on about a quarter of days across that season, so the
            real cure window is always a forecast call. Late summer gives the
            best odds of a dry run. Good crews book out ahead of the season, so
            spring is when to line the work up.
          </p>
        </section>
      )}

      {housing?.heritage && (
        <section>
          <h2>Check whether you're in a heritage district</h2>
          <p>
            {city.name} has {housing.heritage.hcd_count} Heritage Conservation
            Districts, {housing.heritage.examples.slice(0, 4).join(', ')} and
            Kensington Market among them. Inside one, changing an exterior
            finish can require a heritage permit. The century brick that makes
            these neighbourhoods good limewash territory is the same brick the
            rules exist to protect, so look up your address on the city's
            heritage map before you book anything.
          </p>
        </section>
      )}

      <section>
        <h2>{content.process.heading}</h2>
        <ol class="process">
          {content.process.steps.map((s) => <li>{s}</li>)}
        </ol>
      </section>

      <section>
        <h2>Frequently asked questions</h2>
        {content.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <p class="provenance fine">
        Local figures on this page come from Statistics Canada, Environment and
        Climate Change Canada and the City of Toronto. Last checked 1 August 2026.
      </p>
    </div>

    <aside class="rail" id="quote">
      <QuoteForm niche={niche} city={city} />
    </aside>
  </div>

  <a class="cta-bar" href="#quote">Get a quote</a>
</Base>

<style>
  .crumbs {
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs span[aria-hidden] {
    color: var(--ink-faint);
    padding-inline: 0.15rem;
  }

  .money {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .money {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: var(--space-4);
    }

    .rail {
      position: sticky;
      top: var(--space-2);
    }

    .cta-bar {
      display: none;
    }
  }

  .hero {
    margin: 0 0 var(--space-3);
    position: relative;
  }

  .hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .hero figcaption {
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: var(--space-1);
  }

  .badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  .badge,
  .chip {
    font-family: var(--sans);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.04em;
    background: var(--paper);
    color: var(--ink);
    padding: 0.3rem 0.6rem;
  }

  .chip {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
  }

  /* Fallback until real photography lands: an editorial plate, not a hole.
     Reads as a designed element rather than a broken image. */
  .hero-empty {
    aspect-ratio: 21 / 8;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    text-align: center;
    padding: var(--space-3);
  }

  .hero-empty .label {
    color: var(--accent);
  }

  .hero-empty-note {
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: 24rem;
  }

  .kicker {
    color: var(--accent);
    margin-bottom: var(--space-1);
  }

  .dateline {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: clamp(var(--step-3), 4.5vw, var(--step-4));
    margin-bottom: var(--space-2);
  }

  /* Same size as body copy. One reading size on the page; hierarchy comes
     from headings and spacing, not from a second body size. */
  .answer {
    max-width: var(--measure);
  }

  .answer p {
    margin-bottom: var(--space-2);
  }

  .databand {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    border: 1px solid var(--rule);
    margin-block: var(--space-3) var(--space-4);
  }

  .tile {
    padding: 0.9rem 1rem;
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .tile:last-child {
    border-right: 0;
  }



  .tile-value {
    font-size: var(--step-0);
    font-weight: 600;
  }

  section {
    margin-bottom: var(--space-4);
    max-width: 40rem;
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-2);
  }

  section p {
    margin-bottom: var(--space-2);
  }

  .costs {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-bottom: var(--space-2);
  }

  .costs th {
    text-align: left;
  }

  .costs th,
  .costs td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .process {
    padding-left: 1.2rem;
  }

  .process li {
    margin-bottom: var(--space-1);
  }

  .faq {
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-1);
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq p {
    margin-block: var(--space-1);
    color: var(--ink-soft);
  }

  .provenance {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2);
    max-width: 40rem;
  }

  .cta-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    background: var(--accent);
    color: #fff;
    font-family: var(--sans);
    font-size: var(--step-0);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    padding: 0.9rem;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { getNiche, getCity, getPages, getModules } from '../../lib/data.js';

export function getStaticPaths() {
  return getPages().map((p) => ({ params: { niche: p.niche, city: p.city }, props: { status: p.status } }));
}

const { niche: nicheId, city: citySlug } = Astro.params;
const { status } = Astro.props;

const niche = getNiche(nicheId);
const city = getCity(citySlug);
const modules = getModules(citySlug, nicheId);

const contentFiles = import.meta.glob('../../../data/content/*.json', { eager: true });
const content = Object.values(contentFiles)
  .map((m) => m.default ?? m)
  .find((c) => c.niche === nicheId && c.city === citySlug);

const housing = modules.housing_age;
const cost = modules.cost;
const climate = modules.climate_curing;

const MONTH_FULL = { jan: 'January', feb: 'February', mar: 'March', apr: 'April', may: 'May', jun: 'June', jul: 'July', aug: 'August', sep: 'September', oct: 'October', nov: 'November', dec: 'December' };
const monthFull = (m) => MONTH_FULL[m] ?? m;
const window_ = climate?.derived?.limewash_exterior_window;

const consumerTerm = niche.consumer_terms[1] ?? niche.consumer_terms[0];
const h1 = `${consumerTerm.charAt(0).toUpperCase()}${consumerTerm.slice(1)} in ${city.name}`;
const title = `${h1}: Season, Heritage Rules & Getting a Quote`;
const description = content.answer.join(' ').slice(0, 155);
const hero = content.hero ?? {};
const CLUSTERS = { 'specialty-finishes': 'Specialty finishes', drainage: 'Drainage', roofing: 'Roofing' };
const kicker = CLUSTERS[niche.cluster] ?? niche.name;
const RELATED = { 'venetian-plaster': 'Venetian plaster', 'roman-clay': 'Roman clay', 'brick-staining': 'Brick staining', 'lime-mortar-repointing': 'Lime mortar repointing' };
const related = (niche.adjacent_niches ?? []).map((id) => RELATED[id]).filter(Boolean);

// Label/value pairs. A tile renders only from real module data, never a default.
const tiles = [];
if (window_?.full_months?.length) {
  tiles.push({
    label: 'Season',
    value: `${monthFull(window_.full_months[0])} to ${monthFull(window_.full_months.at(-1))}`,
  });
}
if (housing?.heritage?.hcd_count != null) {
  tiles.push({ label: 'Heritage districts', value: housing.heritage.hcd_count_short ?? housing.heritage.hcd_count_display ?? `${housing.heritage.hcd_count}` });
}
if (housing?.period_of_construction?.pre_1961_pct != null) {
  // Framed as abundance in the city, never as a filter on the reader (voice rule).
  // No hardcoded phrase bands: those render an identical sentence across every
  // city in the band, which is exactly what the dedup linter exists to catch.
  tiles.push({
    label: 'Older brick stock',
    value: `${housing.period_of_construction.pre_1961_pct}% of homes`,
  });
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Quotd', item: 'https://getquotd.com/' },
    { '@type': 'ListItem', position: 2, name: niche.name, item: `https://getquotd.com/${niche.id}` },
    { '@type': 'ListItem', position: 3, name: city.name, item: `https://getquotd.com/${niche.id}/${city.slug}` },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: niche.name,
  areaServed: { '@type': 'City', name: city.name },
  provider: { '@type': 'Organization', name: 'Quotd', url: 'https://getquotd.com' },
};
---

<Base title={title} description={description} cta noindex={status !== 'published'}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <nav class="page crumbs" aria-label="Breadcrumb">
    <a href="/">Quotd</a> <span aria-hidden="true">/</span> <span>{niche.name}</span>
    <span aria-hidden="true">/</span> <span>{city.name}</span>
  </nav>

  <div class="page money">
    <div class="main">
      {hero.image ? (
        <figure class="hero">
          <img src={hero.image} alt={hero.alt} width="1200" height="750" fetchpriority="high" />
          {hero.badges?.length > 0 && (
            <div class="badges">{hero.badges.map((b) => <span class="badge">{b}</span>)}</div>
          )}
          {hero.chip && <span class="chip">{hero.chip}</span>}
          {hero.caption && <figcaption>{hero.caption}</figcaption>}
        </figure>
      ) : (
        <div class="hero hero-empty">
          <span class="eyebrow">{niche.name}</span>
          <span class="hero-empty-note">{hero.pending ?? 'Real limewashed brick, Toronto project. Awaiting owner photography.'}</span>
        </div>
      )}

      <p class="kicker eyebrow">{kicker}</p>
      <h1>{h1}</h1>
      <p class="dateline">{city.name}, {city.admin}</p>

      <div class="answer">
        {content.answer.map((p) => <p>{p}</p>)}
      </div>

      {tiles.length > 0 && (
        <div class="databand" aria-label="Local facts">
          {tiles.map((t) => (
            <div class="card tile">
              <p class="tile-value num">{t.value}</p>
              <p class="tile-label">{t.label}</p>
            </div>
          ))}
        </div>
      )}

      <section>
        <h2>{content.verdict.heading}</h2>
        {content.verdict.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      {window_ && (
        <section>
          <h2>When to book it</h2>
          <p>
            Limewash needs mild temperatures and a couple of dry days to cure,
            so the season here is finite.
            {' '}<strong>{monthFull(window_.full_months[0])} through {monthFull(window_.full_months.at(-1))}</strong>
            {' '}is the dependable stretch. April works late in the month once
            frost risk fades, and October only early, before the first frost
            returns around the start of November.
          </p>
          <p>
            Rain falls on about a quarter of days across that season, so the
            real cure window is always a forecast call. Late summer gives the
            best odds of a dry run. Good crews book out ahead of the season, so
            spring is when to line the work up.
          </p>
        </section>
      )}

      {housing?.heritage && (
        <section>
          <h2>Check whether you're in a heritage district</h2>
          <p>
            {city.name} has {housing.heritage.hcd_count_display ?? housing.heritage.hcd_count} Heritage
            Conservation Districts, {housing.heritage.examples.slice(0, 4).join(', ')} and
            Kensington Market among them. Inside one, changing an exterior
            finish can require a heritage permit. The century brick that makes
            these neighbourhoods good limewash territory is the same brick the
            rules exist to protect, so look up your address on the city's
            heritage map before you book anything.
          </p>
        </section>
      )}

      <section>
        <h2>{content.process.heading}</h2>
        <ol class="process">
          {content.process.steps.map((s) => <li>{s}</li>)}
        </ol>
      </section>

      <section>
        <h2>Frequently asked questions</h2>
        {content.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      {related.length > 0 && (
        <section class="related">
          <h2>Related work in {city.name}</h2>
          <ul class="chips">
            {related.map((r) => <li>{r}</li>)}
          </ul>
        </section>
      )}

      <section class="card built">
        <p class="built-title">How this page is built</p>
        <ul>
          <li>Local figures come from Statistics Canada, Environment and Climate Change Canada and the City of Toronto</li>
          <li>Seasonal advice is derived from 1991 to 2020 climate normals for {city.name}, not national averages</li>
          <li>Last checked 1 August 2026. Rules and records change, so confirm permit questions with the city</li>
        </ul>
      </section>
    </div>

    <aside class="rail" id="quote">
      <QuoteForm niche={niche} city={city} />
    </aside>
  </div>

  <a class="cta-bar btn btn-primary btn-lg" href="#quote">Get a quote</a>
</Base>

<style>
  .crumbs {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    margin-bottom: var(--s6);
    display: flex;
    gap: var(--s2);
    flex-wrap: wrap;
  }

  .crumbs a:hover { color: var(--brand-700); }
  .crumbs span[aria-hidden] { color: var(--text-meta); }

  .money {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s8);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .money {
      grid-template-columns: minmax(0, 1fr) 23rem;
      gap: var(--s16);
    }
    .rail { position: sticky; top: calc(4rem + var(--s6)); }
    .cta-bar { display: none; }
  }

  /* Hero */
  .hero { margin: 0 0 var(--s8); position: relative; }

  .hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-panel);
  }

  .hero figcaption {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    margin-top: var(--s3);
  }

  .badges {
    position: absolute;
    top: var(--s4);
    left: var(--s4);
    display: flex;
    gap: var(--s2);
  }

  .badges .badge { background: rgba(255, 255, 255, 0.92); color: var(--slate-900); }

  .chip {
    position: absolute;
    right: var(--s4);
    bottom: var(--s4);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--slate-900);
    padding: 0.125rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .hero-empty {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: var(--slate-50);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    text-align: center;
    padding: var(--s8);
  }

  .hero-empty-note { font-size: var(--text-sm); color: var(--text-meta); max-width: 26rem; }

  /* Head */
  .kicker { margin-bottom: var(--s4); }

  h1 {
    font-size: clamp(var(--text-4xl), 4.6vw, var(--text-5xl));
    color: var(--ink);
    margin-bottom: var(--s3);
    max-width: 18ch;
  }

  .dateline {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    margin-bottom: var(--s6);
  }

  .answer {
    max-width: var(--read);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .answer p + p { margin-top: var(--s4); }

  /* Stat row: value first, label under. */
  .databand {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--s3);
    margin-block: var(--s10);
  }

  .tile { padding: var(--s5); }

  .tile-value {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  .tile-label {
    margin-top: 0.125rem;
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }

  /* Sections */
  section { margin-bottom: var(--s16); max-width: var(--read); }

  h2 {
    font-size: var(--text-3xl);
    color: var(--ink);
    margin-bottom: var(--s4);
  }

  section p { color: var(--text-muted); }
  section p + p { margin-top: var(--s4); }

  .fine { font-size: var(--text-sm); color: var(--text-subtle); }

  .process { list-style: none; padding: 0; counter-reset: step; }

  .process li {
    counter-increment: step;
    position: relative;
    padding-left: 2.75rem;
    margin-bottom: var(--s5);
    color: var(--text-muted);
  }

  .process li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05rem;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    background: var(--slate-50);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
  }

  /* FAQ: dividers over boxes. */
  .faq { border-bottom: 1px solid var(--slate-100); }

  .faq summary {
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--slate-900);
    padding-block: var(--s4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s4);
  }

  .faq summary::-webkit-details-marker { display: none; }

  .faq summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--text-meta);
    border-bottom: 1.5px solid var(--text-meta);
    transform: rotate(45deg) translate(-2px, -2px);
    flex: none;
  }

  .faq[open] summary::after { transform: rotate(-135deg) translate(-2px, -2px); }

  .faq p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    padding-bottom: var(--s5);
    max-width: 40rem;
  }

  /* Related services: pills */
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }

  .chips li {
    font-size: var(--text-sm);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    padding: 0.5rem 0.875rem;
    color: var(--text-muted);
  }

  /* Trust card */
  .built { padding: var(--s5); }

  .built-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--slate-900);
    margin-bottom: var(--s3);
  }

  .built ul { list-style: none; padding: 0; display: grid; gap: var(--s2); }

  .built li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .built li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.45rem;
    width: 0.35rem;
    height: 0.6rem;
    border-right: 2px solid var(--brand-600);
    border-bottom: 2px solid var(--brand-600);
    transform: rotate(45deg);
  }

  .cta-bar {
    position: fixed;
    inset-inline: var(--s4);
    bottom: var(--s4);
    z-index: 30;
    box-shadow: var(--shadow-lg);
  }
</style>

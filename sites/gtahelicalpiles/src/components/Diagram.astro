---
// Sectional line diagram: a concrete sonotube pier in the frost zone next to a
// helical pile bearing below it. Drawn by hand as inline SVG so it scales and
// reads in the page's own type. Not to scale. The frost-zone depth is the
// minimum pier depth on Halton municipalities' own deck drawings (Oakville,
// Milton), not a Building Code citation; the page states the source.
//
// Explanations live in a numbered key under the drawing so they stay legible
// at phone width, where SVG text would shrink below reading size.
interface Props {
  frostDepthLabel?: string; // short second line for the frost band, e.g. "to 1.2 m"
  caption?: string;
}
const { frostDepthLabel = 'to 1.2 m', caption } = Astro.props;
---

<figure class="diagram">
  <svg viewBox="0 0 780 440" role="img" aria-labelledby="diagram-title diagram-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="diagram-title">Concrete pier versus helical pile in frost-prone ground</title>
    <desc id="diagram-desc">Cross-section. On the left, a concrete sonotube pier sits with much of its length inside the frost zone; freezing soil grips its rough sides and lifts it. On the right, a helical pile's smooth galvanized shaft passes through the frost zone and its helix plate bears in undisturbed soil below it.</desc>

    <!-- Deck level -->
    <line x1="40" y1="70" x2="740" y2="70" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="4 4" />
    <text x="44" y="58" class="lbl muted">Deck beam</text>

    <!-- Ground surface -->
    <line x1="40" y1="130" x2="740" y2="130" stroke="var(--ink)" stroke-width="2" />
    <text x="44" y="120" class="lbl">Grade</text>

    <!-- Frost zone band -->
    <rect x="40" y="130" width="700" height="120" fill="var(--brand-50)" />
    <line x1="40" y1="250" x2="740" y2="250" stroke="var(--brand-600)" stroke-width="1.5" stroke-dasharray="6 4" />
    <text x="44" y="162" class="lbl brand">Frost zone</text>
    <text x="44" y="190" class="lbl brand">{frostDepthLabel}</text>

    <!-- Bearing soil below -->
    <text x="44" y="412" class="lbl muted">Undisturbed soil</text>

    <!-- LEFT: sonotube pier (rough, mostly in frost zone, lifted) -->
    <g transform="translate(330 0)">
      <rect x="-12" y="70" width="24" height="26" fill="none" stroke="var(--ink)" stroke-width="2" />
      <path d="M-28 96 L28 96 L30 120 L26 150 L31 180 L27 210 L30 240 L26 262 L-26 262 L-30 240 L-27 210 L-31 180 L-26 150 L-30 120 Z" fill="var(--bg)" stroke="var(--ink)" stroke-width="2" />
      <g stroke="var(--warn)" stroke-width="2.5" fill="none">
        <path d="M-50 232 L-50 172 M-50 172 l-7 9 M-50 172 l7 9" />
        <path d="M50 232 L50 172 M50 172 l-7 9 M50 172 l7 9" />
      </g>
      <path d="M-30 264 q30 8 60 0" fill="none" stroke="var(--warn)" stroke-width="2" stroke-dasharray="3 3" />
      <circle cx="0" cy="300" r="15" fill="var(--ink)" />
      <text x="0" y="306" text-anchor="middle" class="lbl key">1</text>
      <text x="0" y="346" text-anchor="middle" class="lbl">Concrete sonotube</text>
    </g>

    <!-- RIGHT: helical pile (smooth shaft, helix below frost) -->
    <g transform="translate(640 0)">
      <rect x="-22" y="72" width="44" height="10" fill="var(--ink)" />
      <rect x="-6" y="82" width="12" height="14" fill="none" stroke="var(--ink)" stroke-width="2" />
      <rect x="-6" y="96" width="12" height="250" fill="var(--bg)" stroke="var(--ink)" stroke-width="2" />
      <path d="M-40 318 L40 330 L40 338 L-40 326 Z" fill="var(--bg)" stroke="var(--ink)" stroke-width="2" />
      <path d="M-40 318 L-40 326" stroke="var(--ink)" stroke-width="2" />
      <path d="M-6 346 L0 366 L6 346" fill="var(--bg)" stroke="var(--ink)" stroke-width="2" />
      <g stroke="var(--ok)" stroke-width="2.5" fill="none">
        <path d="M-24 372 L-24 348 M-24 348 l-6 8 M-24 348 l6 8" />
        <path d="M24 376 L24 352 M24 352 l-6 8 M24 352 l6 8" />
      </g>
      <circle cx="-40" cy="190" r="15" fill="var(--ink)" />
      <text x="-40" y="196" text-anchor="middle" class="lbl key">2</text>
      <circle cx="66" cy="326" r="15" fill="var(--ink)" />
      <text x="66" y="332" text-anchor="middle" class="lbl key">3</text>
      <text x="0" y="412" text-anchor="middle" class="lbl">Helical pile</text>
    </g>
  </svg>
  <ol class="diagram-key small muted">
    <li>Frozen soil grips the rough sides of a concrete pier and lifts it.</li>
    <li>A smooth galvanized shaft gives frost far less to grip.</li>
    <li>The helix bears in undisturbed soil below the frost zone.</li>
  </ol>
  {caption && <figcaption class="small muted">{caption}</figcaption>}
</figure>

<style>
  .diagram { margin: 0; }
  .diagram svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: var(--bg);
  }
  .diagram-key {
    margin: var(--s3) 0 0;
    padding-left: 1.5rem;
    display: grid;
    gap: var(--s1);
    line-height: 1.5;
  }
  .diagram-key li::marker { font-weight: 600; color: var(--text); }
  .diagram figcaption { margin-top: var(--s3); }
  /* SVG text is sized in viewBox units: 24 units reads at about 11px on a
     390px phone and 21px on desktop. */
  .lbl { font-family: var(--sans); font-size: var(--text-2xl); fill: var(--text); }
  .lbl.muted { fill: var(--grey-text); }
  .lbl.brand { fill: var(--brand-700); font-weight: 600; }
  .lbl.key { fill: var(--on-dark); font-weight: 700; font-size: var(--text-xl); }
</style>
